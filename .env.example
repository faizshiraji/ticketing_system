# Django
DEBUG=True
SECRET_KEY=change-me-to-a-random-value
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=ccl_ccdl_ticketing
DB_USER=ticketing_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Email (used for synchronous notifications in this phase)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CCL/CCDL Support <no-reply@example.com>
SUPPORT_TEAM_EMAIL=support-team@example.com

# CORS (Vue Vite dev server)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# LDAP / Active Directory (cg-bd.com) — same keys as working ERP project
LDAP_ENABLED=false
LDAP_ALLOW_LOCAL_FALLBACK=true
LDAP_LOGGING=true
LDAP_URI=ldaps://ad02.cg-bd.com:636
LDAP_BASE_DN=DC=cg-bd,DC=com
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USE_STARTTLS=false
LDAP_UPN_SUFFIX=cg-bd.com
LDAP_BIND_FORMAT=upn
LDAP_TLS_REQUIRE_CERT=demand
LDAP_TIMEOUT=8
LDAP_REQUIRE_SERVICE_BIND=false
LDAP_EMAIL_DOMAIN=cg-bd.com
# LDAP_COMPANY_GROUP_MAP=CN=CCL Users,OU=Groups,DC=cg-bd,DC=com:ccl;CN=CCDL Users,OU=Groups,DC=cg-bd,DC=com:ccdl
LDAP_COMPANY_GROUP_MAP=
